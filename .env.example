POSTGRES_USER=shohor
POSTGRES_PASSWORD=shohor_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
AUTH_SECRET_KEY=change-me-auth
CATALOG_SECRET_KEY=change-me-catalog
MEDIA_SECRET_KEY=change-me-media
CUSTOM_REQUEST_SECRET_KEY=change-me-custom-request
PROVIDER_SECRET_KEY=change-me-provider
ORDER_SECRET_KEY=change-me-order
SUBSCRIPTION_SECRET_KEY=change-me-subscription
PAYMENT_SECRET_KEY=change-me-payment
CHAT_SECRET_KEY=change-me-chat
NOTIFICATION_SECRET_KEY=change-me-notification
CORS_ALLOWED_ORIGINS=http://localhost:5173

# dev: OTP codes are logged instead of sent by SMS
OTP_DEBUG=1

# host port for the nginx gateway
GATEWAY_PORT=8088

# shared secret for service-to-service calls
INTERNAL_API_TOKEN=change-me-internal
REDIS_URL=redis://redis:6379/0

# business settings
ORDER_DELIVERY_FEE=0
PROVIDER_COMMISSION_PERCENT=15
CUSTOM_REQUEST_ADVANCE_PERCENT=30

# payments: "mock" serves a local test checkout; set "sslcommerz" plus store credentials for bKash/Nagad/cards
PAYMENT_GATEWAY=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=1
PUBLIC_API_URL=http://localhost:8088
CUSTOMER_WEB_URL=http://localhost:5173

# SMS: "console" logs texts; "http" posts to SMS_API_URL
SMS_BACKEND=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

SUBSCRIPTION_CUTOFF_HOUR=22
STUDENT_DISCOUNT_PERCENT=10
