POSTGRES_USER=shohor
POSTGRES_PASSWORD=shohor_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
AUTH_SECRET_KEY=change-me-auth
CATALOG_SECRET_KEY=change-me-catalog
MEDIA_SECRET_KEY=change-me-media
CUSTOM_REQUEST_SECRET_KEY=change-me-custom-request
PROVIDER_SECRET_KEY=change-me-provider
ORDER_SECRET_KEY=change-me-order
SUBSCRIPTION_SECRET_KEY=change-me-subscription
PAYMENT_SECRET_KEY=change-me-payment
CHAT_SECRET_KEY=change-me-chat
NOTIFICATION_SECRET_KEY=change-me-notification
CITY_SECRET_KEY=change-me-city
LOYALTY_SECRET_KEY=change-me-loyalty
B2B_SECRET_KEY=change-me-b2b
ANALYTICS_SECRET_KEY=change-me-analytics
CORS_ALLOWED_ORIGINS=http://localhost:5173

# dev: OTP codes are logged instead of sent by SMS
OTP_DEBUG=1
# OTP requests per IP. Development value: the demo seed and tests register many users from one machine.
# Production: set 10/hour (see docs/deploy.md).
OTP_THROTTLE_RATE=1000/hour

# host port for the nginx gateway
GATEWAY_PORT=8088

# shared secret for service-to-service calls
INTERNAL_API_TOKEN=change-me-internal
REDIS_URL=redis://redis:6379/0

# business settings
ORDER_DELIVERY_FEE=0
PROVIDER_COMMISSION_PERCENT=15
CUSTOM_REQUEST_ADVANCE_PERCENT=10

# payments: "mock" serves a local test checkout; set "sslcommerz" plus store credentials for bKash/Nagad/cards
PAYMENT_GATEWAY=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=1
PUBLIC_API_URL=http://localhost:8088
CUSTOMER_WEB_URL=http://localhost:5173

# SMS: "console" logs texts; "http" posts to SMS_API_URL
SMS_BACKEND=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

SUBSCRIPTION_CUTOFF_HOUR=22
STUDENT_DISCOUNT_PERCENT=10
EMERGENCY_SURCHARGE_PERCENT=25

# loyalty: points per ৳100 of completed orders, value of a point, max share of an order payable with points
POINTS_PER_100_TAKA=1
POINT_VALUE_TAKA=1
MAX_REDEEM_PERCENT=20
SUBSCRIPTION_BONUS_POINTS=20
REFERRAL_BONUS_TAKA=100
REFERRAL_WELCOME_TAKA=50

# data protection
MEDIA_ENCRYPTION_KEY=
REJECTED_DOCUMENT_RETENTION_DAYS=90
ORDER_DELIVERY_DEADLINE_DAYS=5

# production
SENTRY_DSN=
CSRF_TRUSTED_ORIGINS=
CUSTOMER_DOMAIN=
PARTNER_DOMAIN=
ADMIN_DOMAIN=

# AI photo quote (Dhap 8): leave empty to use the keyword match
ANTHROPIC_API_KEY=
